config CUSTOM_KERNEL_SENSORHUB
	tristate "CUSTOM KERNEL SENSORHUB support"
	help
	  Kernel space sensor hub driver.
	  Define project used all sensor hub
	  sensors. The value is combination of sensor hub driver(get data...etc)
	  and sensor hub framework driver(transmit shf info)

config CUSTOM_KERNEL_ALS_MULTI_CALI_SUPPORT
	bool "multi_cali for MediaTek package"
	help
	  It support multi_cali.
	  If this option is set,
	  it will support
	  multi_cali.

config CUSTOM_KERNEL_SCP_BUMP_UP
	bool "set scp in a higher mips for ARES"
	help
	  It support ares set scp to a higher mips.

config CUSTOM_KERNEL_CCT
	bool "cct_cali for MediaTek package"
	help
	  It support cct_cali.
	  If this option is set,
	  it will support
	  cct_cali.

source "drivers/misc/mediatek/sensor/2.0/mtk_nanohub/nanohub/Kconfig"
